# Render static site redirects
# See: https://render.com/docs/redirects-rewrites

# Proxy all /api/* calls to the Vercel backend
/api/*  https://aripan-two.vercel.app/api/:splat  200

# Proxy all /media/* calls to the Vercel backend
/media/*  https://aripan-two.vercel.app/media/:splat  200

# Serve the admin panel directly (must come before the SPA catch-all)
/aripan-admin-secure    /aripan-admin-secure/index.html  200
/aripan-admin-secure/*  /aripan-admin-secure/index.html  200

# SPA catch-all — serve React app for all other routes
/*  /index.html  200
