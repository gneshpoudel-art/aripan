{
  "version": 2,
  "builds": [
    {
      "src": "server/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/**",
          "src/data/**",
          "public/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.ts" },
    { "src": "/media/(.*)", "dest": "server/index.ts" },
    { "src": "/aripan-admin-secure", "dest": "server/index.ts" },
    { "src": "/aripan-admin-secure/(.*)", "dest": "server/index.ts" }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "framework": null
}
